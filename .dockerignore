# Всё, что собирается внутри контейнера или не относится к сборке.
# Без этого в образ уезжают node_modules и target с локальной машины — сборка
# замедляется, а npm ci может подхватить чужие бинарники под другую платформу.
.git
.gitignore
**/node_modules
**/target
**/dist
backend/data
docs/*.pdf
*.md
!docs/rules.md
