### Воздушный Шар — ручная проверка API
# Открыть в VS Code с расширением REST Client (humao.rest-client) и жать
# "Send Request" над нужным блоком. Поднятый бэкенд: cd backend && ./mvnw spring-boot:run
#
# Для проверки живого полёта шара удобнее страница http://localhost:8080/ws-test.html —
# она показывает поток STOMP-событий и кнопку «Забрать».

@host = http://localhost:8080
@roundId = r-1

### Стартовое состояние: баланс, варианты ставок, количество уровней
GET {{host}}/api/state

### Правила игры (обязательный доступ до подтверждения ставки)
GET {{host}}/api/rules

### История завершённых раундов
GET {{host}}/api/history?limit=20

### Текущая конфигурация игры
GET {{host}}/api/config

### Пополнить демо-баланс до стартового (повторный вызов вернёт credited: 0)
POST {{host}}/api/demo/topup

### Старт раунда — обычный, случайный исход
POST {{host}}/api/round/start
Content-Type: application/json

{
  "theme": "green",
  "stake": 150,
  "boostOptionId": "boost-x2"
}

### Старт раунда — dev: фиксированный seed + ускорение в 5 раз
# Один и тот же seed даёт один и тот же раунд: и точку краха, и позицию бустера.
POST {{host}}/api/round/start
Content-Type: application/json

{
  "theme": "green",
  "stake": 100,
  "boostOptionId": "boost-x3",
  "seed": 42,
  "speedFactor": 5
}

### Старт раунда — красная тема (12 уровней)
POST {{host}}/api/round/start
Content-Type: application/json

{
  "theme": "red",
  "stake": 200,
  "boostOptionId": "boost-x4",
  "seed": 3,
  "speedFactor": 3
}

### Забрать выигрыш (доступно только после первого уровня)
POST {{host}}/api/round/{{roundId}}/cashout

### Итог раунда (доступен после краха) — выигрыш, очки, награда, serverSeed
GET {{host}}/api/round/{{roundId}}

### Ошибка: несуществующий вариант ставки -> INVALID_BET_OPTION
POST {{host}}/api/round/start
Content-Type: application/json

{
  "theme": "green",
  "stake": 50,
  "boostOptionId": "nope"
}

### Ошибка: неизвестная тема -> VALIDATION_ERROR
POST {{host}}/api/round/start
Content-Type: application/json

{
  "theme": "blue",
  "stake": 50,
  "boostOptionId": "no-boost"
}

### Статистика мат. модели — обоснование расчётами, а не одним раундом
GET {{host}}/api/dev/simulate?rounds=20000&theme=green

### Статистика по красной теме
GET {{host}}/api/dev/simulate?rounds=20000&theme=red

### Админка: сохранить конфигурацию (полный JSON)
# Проще всего: выполнить GET /api/config выше, скопировать ответ сюда и поправить.
# Ниже — текущая конфигурация целиком, как она лежит в config/game.json.
PUT {{host}}/api/config
Content-Type: application/json

{
  "game_id": "vozdushny-shar",
  "game_name": "Воздушный Шар",
  "game_type": "crash",
  "is_active": true,

  "demo_user": {
    "id": "guest",
    "starting_balance": 1000
  },

  "stake": {
    "min": 10,
    "max": 400,
    "step": 5,
    "presets": [25, 50, 100, 200]
  },

  "boost_options": [
    { "id": "no-boost", "boost_tier": 1, "price_factor": 0.0 },
    { "id": "boost-x2", "boost_tier": 2, "price_factor": 0.5 },
    { "id": "boost-x3", "boost_tier": 3, "price_factor": 1.0 },
    { "id": "boost-x4", "boost_tier": 4, "price_factor": 1.5 }
  ],

  "themes": {
    "green": {
      "levels_count": 9,
      "level_thresholds": [1.10, 1.25, 1.45, 1.70, 2.00, 2.50, 3.20, 4.50, 7.00],
      "loot_probabilities": {
        "line_1_loot_prob": 0.05,
        "line_2_loot_prob": 0.08,
        "line_3_loot_prob": 0.12,
        "line_4_loot_prob": 0.15,
        "line_5_loot_prob": 0.15,
        "line_6_loot_prob": 0.15,
        "line_7_loot_prob": 0.12,
        "line_8_loot_prob": 0.10,
        "line_9_loot_prob": 0.08
      }
    },
    "red": {
      "levels_count": 12,
      "level_thresholds": [1.08, 1.18, 1.30, 1.45, 1.65, 1.90, 2.25, 2.70, 3.30, 4.20, 5.60, 8.00],
      "loot_probabilities": {
        "line_1_loot_prob": 0.03,
        "line_2_loot_prob": 0.05,
        "line_3_loot_prob": 0.07,
        "line_4_loot_prob": 0.09,
        "line_5_loot_prob": 0.11,
        "line_6_loot_prob": 0.12,
        "line_7_loot_prob": 0.12,
        "line_8_loot_prob": 0.11,
        "line_9_loot_prob": 0.09,
        "line_10_loot_prob": 0.08,
        "line_11_loot_prob": 0.07,
        "line_12_loot_prob": 0.06
      }
    }
  },

  "crash_model": {
    "alpha": 0.97,
    "max_multiplier": 50.0,
    "min_crash_multiplier": 1.00,
    "multiplier_growth_rate": 0.06,
    "growth_acceleration_base": 1.12,
    "fps": 10,
    "delta": 0.1
  },

  "boost_tiers": {
    "multiplier_tier_1_value": 1.0,
    "multiplier_tier_2_value": 2.0,
    "multiplier_tier_3_value": 3.0,
    "multiplier_tier_4_value": 4.0
  },

  "points": {
    "points_per_line": 10,
    "points_cashout_bonus": 50,
    "points_boost_bonus": 100
  },

  "rewards": {
    "pool": [
      { "id": "puzzle-piece-1", "type": "puzzle-piece", "weight": 40 },
      { "id": "puzzle-piece-2", "type": "puzzle-piece", "weight": 40 },
      { "id": "bonus-token", "type": "token", "weight": 20 }
    ]
  },

  "upsell": {
    "min_win_amount": 50,
    "popup_timeout_sec": 10
  },

  "ui": {
    "result_screen_auto_advance_sec": 10,
    "onboarding_hint_duration_sec": 4
  },

  "dev_mode": {
    "enabled": true,
    "_comment": "Разрешает поля seed и speedFactor в POST /api/round/start. Перед сдачей экспертам решить: оставить true (удобно демонстрировать бустер) или выключить. При false сервер игнорирует эти поля."
  }
}

### Админка: валидация — пороги уровней не возрастают
PUT {{host}}/api/config
Content-Type: application/json

{
  "stake": { "min": 10, "max": 400, "step": 5, "presets": [25, 50] },
  "boost_options": [{ "id": "no-boost", "boost_tier": 1, "price_factor": 0.0 }],
  "crash_model": { "alpha": 0.97, "max_multiplier": 50, "min_crash_multiplier": 1,
                   "multiplier_growth_rate": 0.06, "growth_acceleration_base": 1.12,
                   "fps": 10, "delta": 0.1 },
  "points": { "points_per_line": 10, "points_cashout_bonus": 50, "points_boost_bonus": 100 },
  "themes": {
    "green": {
      "levels_count": 3,
      "level_thresholds": [2.0, 1.5, 3.0],
      "loot_probabilities": { "line_1_loot_prob": 1.0 }
    }
  }
}

### Админка: валидация — бустер дороже честной цены (×2 при price_factor 1.5)
# Такой бустер невыгоден при любой стратегии: см. docs/math-model.md, раздел 4.
PUT {{host}}/api/config
Content-Type: application/json

{
  "stake": { "min": 10, "max": 400, "step": 5, "presets": [25, 50] },
  "boost_options": [
    { "id": "no-boost", "boost_tier": 1, "price_factor": 0.0 },
    { "id": "boost-x2", "boost_tier": 2, "price_factor": 1.5 }
  ],
  "boost_tiers": { "multiplier_tier_1_value": 1.0, "multiplier_tier_2_value": 2.0 },
  "crash_model": { "alpha": 0.97, "max_multiplier": 50, "min_crash_multiplier": 1,
                   "multiplier_growth_rate": 0.06, "growth_acceleration_base": 1.12,
                   "fps": 10, "delta": 0.1 },
  "points": { "points_per_line": 10, "points_cashout_bonus": 50, "points_boost_bonus": 100 },
  "themes": {
    "green": {
      "levels_count": 1,
      "level_thresholds": [1.1],
      "loot_probabilities": { "line_1_loot_prob": 1.0 }
    }
  }
}
