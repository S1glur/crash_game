# Java / Spring Boot (backend)
backend/target/
backend/*.iml
backend/.classpath
backend/.project
backend/.settings/
*.class
*.jar
# backend/.mvn/wrapper/ НЕ игнорируем: без maven-wrapper.properties команда ./mvnw
# падает у каждого, кто просто склонировал репозиторий, включая экспертов.
!backend/.mvn/wrapper/*.jar

# Node / React (frontend)
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*

# Env / secrets
.env
.env.local
*.env

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# H2 database files (local dev)
*.mv.db
*.trace.db
# Папка базы целиком: рядом с ней заводятся резервные копии, которые по маске
# *.mv.db не ловятся и лезут в коммит.
backend/data/
balloon.jar
